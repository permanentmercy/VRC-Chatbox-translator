<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="VrcChatboxDemo.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:VrcChatboxDemo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Vrc Chatbox By Mercy's BUG"
    mc:Ignorable="d">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootWindowGrid">
        <!-- 正常模式：包含自定义系统标题栏与左侧抽屉导航 -->
        <Grid x:Name="NormalModeGrid">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="TitleBarRow" Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自定义系统标题栏与纯图标无框置顶按钮 -->
            <Grid x:Name="TitleBarContainer" Grid.Row="0">
                <TitleBar x:Name="AppTitleBar" Title="Vrc Chatbox By Mercy's BUG">
                    <TitleBar.IconSource>
                        <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                    </TitleBar.IconSource>
                </TitleBar>

                <!-- 沉浸模式快捷切换按钮 -->
                <Button x:Name="ImmersiveButton"
                        Click="ImmersiveButton_Click"
                        ToolTipService.ToolTip="进入沉浸模式 (Ctrl + Shift + Z)"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,176,0"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon Glyph="&#xE740;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Button>

                <!-- 纯图标、无外框、背景透明置顶按钮 -->
                <Button x:Name="TopMostButton"
                        Click="TopMostButton_Click"
                        ToolTipService.ToolTip="窗口始终置顶"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,140,0"
                        Width="36"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0">
                    <Button.Resources>
                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#1AFFFFFF" />
                        <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#33FFFFFF" />
                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                    </Button.Resources>
                    <FontIcon x:Name="TopMostIcon" Glyph="&#xE840;" FontSize="13" />
                </Button>
            </Grid>

            <!-- 左侧抽屉式导航栏 (NavigationView) -->
            <NavigationView x:Name="NavView"
                            Grid.Row="1"
                            PaneDisplayMode="LeftCompact"
                            IsPaneOpen="False"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="NavView_SelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="ChatNavItem" Content="消息发送" Tag="chat">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8BD;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>

                    <NavigationViewItem x:Name="SpeechNavItem" Content="语音识别" Tag="speech">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE720;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="TranslationNavItem" Content="翻译配置" Tag="translation">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE8C1;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="TtsNavItem" Content="TTS 语音" Tag="tts">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE768;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="HotkeyNavItem" Content="快捷热键" Tag="hotkey">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE765;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="InteractionNavItem" Content="交互发送" Tag="interaction">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE774;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="NetworkLogNavItem" Content="网络日志" Tag="network">
                        <NavigationViewItem.Icon>
                            <FontIcon Glyph="&#xE968;" />
                        </NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <!-- 页面内容呈现区 -->
                <Frame x:Name="ContentFrame" />
            </NavigationView>

            <!-- 拖拽排序指示层 (透明覆盖在左侧栏上方，不拦截任何鼠标事件) -->
            <Canvas x:Name="DragAdornerCanvas" Grid.Row="1" IsHitTestVisible="False">
                <!-- 插入位置指示线 (发光主色线条) -->
                <Border x:Name="DragInsertIndicator"
                        Width="44"
                        Height="3"
                        CornerRadius="1.5"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="Collapsed" />

                <!-- 跟随鼠标的半透明悬浮图标卡片 -->
                <Border x:Name="DragGhostBadge"
                        Width="40"
                        Height="40"
                        CornerRadius="6"
                        Background="#66000000"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="1.5"
                        Visibility="Collapsed">
                    <FontIcon x:Name="DragGhostIcon"
                              FontSize="18"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
            </Canvas>
        </Grid>
    </Grid>
</Window>
