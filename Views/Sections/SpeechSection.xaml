<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="VrcChatboxDemo.Views.Sections.SpeechSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="18">
        <StackPanel Spacing="4">
            <TextBlock Text="语音识别" Style="{StaticResource TitleTextBlockStyle}" />
        </StackPanel>

        <!-- 卡片 1: 语音/字幕识别引擎 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="语音识别与字幕引擎" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />

                <!-- 引擎切换与主开关 -->
                <Grid ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <ToggleSwitch x:Name="SpeechSwitch" Header="启用语音识别 / 字幕监听"
                                  Toggled="SpeechSwitch_Toggled"
                                  ToolTipService.ToolTip="开启后实时监听并转录语音，支持联动沉浸式双语窗口与翻译" />

                    <ComboBox x:Name="SpeechEngineComboBox" Grid.Column="1" Header="识别引擎"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="SpeechEngineComboBox_SelectionChanged"
                              ToolTipService.ToolTip="选择语音识别后端模型：Whisper模型或 Windows 11 实时字幕">
                        <ComboBoxItem Content="Whisper 本地 AI 模型" Tag="Whisper" />
                        <ComboBoxItem Content="Windows 11 实时字幕" Tag="LiveCaptions" />
                    </ComboBox>
                </Grid>

                <!-- CUDA 驱动缺失告警 -->
                <InfoBar x:Name="CudaWarningInfoBar" IsOpen="False" IsClosable="True" Severity="Warning"
                         Title="缺少 GPU 加速驱动"
                         Message="未检测到 NVIDIA CUDA 运行时驱动，亦未在本地检测到 Ollama 内置打包的 CUDA 驱动库 (cuda_v12)。Whisper 无法启用 GPU 硬件加速，仅能以 CPU 模式缓慢运行。建议使用系统原生【Windows 11 实时字幕】引擎或安装 CUDA / Ollama。" />

                <!-- Whisper 专属配置面板 -->
                <Grid x:Name="WhisperOptionsGrid" ColumnSpacing="20" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 模型规格选择 (tiny / base / small) -->
                    <ComboBox x:Name="SpeechModelComboBox" Grid.Row="0" Grid.Column="0" Header="模型规格"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="SpeechModelComboBox_SelectionChanged"
                              ToolTipService.ToolTip="选择 Whisper 本地神经网络模型规格">
                        <ComboBoxItem Content="tiny" Tag="tiny" />
                        <ComboBoxItem Content="base" Tag="base" />
                        <ComboBoxItem Content="small" Tag="small" />
                    </ComboBox>

                    <ComboBox x:Name="SpeechLanguageComboBox" Grid.Row="0" Grid.Column="1" Header="语音识别语言"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="SpeechLanguageComboBox_SelectionChanged"
                              ToolTipService.ToolTip="选择说话人使用的语言（支持自动识别、中文、英语、日语等）" />

                    <!-- 中文繁简体独立选择项 -->
                    <ComboBox x:Name="ChineseVariantComboBox" Grid.Row="1" Grid.Column="0" Header="中文输出偏好"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="ChineseVariantComboBox_SelectionChanged"
                              ToolTipService.ToolTip="Whisper 识别中文时自主选择简繁体，在此可强制规范输出">
                        <ComboBoxItem Content="强制转换为简体中文 (默认)" Tag="Simplified" />
                        <ComboBoxItem Content="强制转换为繁体中文" Tag="Traditional" />
                        <ComboBoxItem Content="保持识别原样" Tag="Original" />
                    </ComboBox>

                    <!-- GPU 负载与算力策略 -->
                    <ComboBox x:Name="GpuModeComboBox" Grid.Row="1" Grid.Column="1" Header="GPU 负载与算力策略"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="GpuModeComboBox_SelectionChanged"
                              ToolTipService.ToolTip="调节 Whisper AI 对 GPU 的算力调用模式。玩大型游戏或 VRChat 时推荐开启【低负载】防止抢占 GPU 导致掉帧卡顿；需要最高实时性可选择【高性能】">
                        <ComboBoxItem Content="高性能" Tag="High" />
                        <ComboBoxItem Content="均衡模式" Tag="Medium" />
                        <ComboBoxItem Content="低负载" Tag="Low" />
                    </ComboBox>

                    <!-- 语音切片时长 -->
                    <ComboBox x:Name="SpeechSliceDurationComboBox" Grid.Row="2" Grid.Column="0" Header="语音切片最长时限"
                              Width="300" HorizontalAlignment="Left"
                              SelectionChanged="SpeechSliceDurationComboBox_SelectionChanged"
                              ToolTipService.ToolTip="自定义单句语音切片的最长持续秒数。达到时限或检测到说话停顿后，自动提交 GPU 队列开始推理">
                        <ComboBoxItem Content="3 秒 (极速断句)" Tag="3" />
                        <ComboBoxItem Content="4 秒" Tag="4" />
                        <ComboBoxItem Content="5 秒" Tag="5" />
                        <ComboBoxItem Content="6 秒 (默认标准)" Tag="6" />
                        <ComboBoxItem Content="8 秒" Tag="8" />
                        <ComboBoxItem Content="10 秒 (长句完整)" Tag="10" />
                        <ComboBoxItem Content="12 秒" Tag="12" />
                        <ComboBoxItem Content="15 秒 (超长段落)" Tag="15" />
                    </ComboBox>
                </Grid>

                <!-- Windows 11 LiveCaptions 专属配置面板 -->
                <StackPanel x:Name="LiveCaptionsPanel" Spacing="10" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ToggleLiveCaptionsButton"
                                Click="ToggleLiveCaptionsButton_Click"
                                ToolTipService.ToolTip="在屏幕上唤出或最小化 Windows 11 原生实时字幕窗口">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE737;" FontSize="14" />
                                <TextBlock Text="呼出 / 隐藏系统字幕窗口" />
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="LiveCaptionsHideNativeCheckBox" Content="自动隐藏caption"
                                  IsChecked="True" Checked="LiveCaptionsHideNativeCheckBox_CheckChanged"
                                  Unchecked="LiveCaptionsHideNativeCheckBox_CheckChanged"
                                  ToolTipService.ToolTip="勾选后，开启时自动将系统自带的黑底字幕窗口最小化，避免遮挡视线" />
                    </StackPanel>
                </StackPanel>

                <!-- 统一引擎状态 -->
                <StackPanel VerticalAlignment="Center" Spacing="2" Margin="0,4,0,0">
                    <TextBlock Text="当前状态" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock x:Name="SpeechStatusTextBlock" Text="就绪" Style="{StaticResource BodyTextBlockStyle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 卡片 2: 音频监听设备 (仅 Whisper 模式生效) -->
        <Border x:Name="AudioDeviceCard" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="音频输入与监听设备" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                <TextBlock Text="支持监听耳机/扬声器中其他玩家的声音 (Loopback)，或直接通过麦克风拾音" 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- 固定宽度的设备选择组，杜绝重排抖动 -->
                <Grid ColumnSpacing="8" Width="480" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="AudioDeviceComboBox" Header="监听音频设备 (扬声器/耳机/麦克风)"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="AudioDeviceComboBox_SelectionChanged"
                              ToolTipService.ToolTip="选择需要监听转录的音频设备（支持扬声器/耳机 Loopback 监听及麦克风拾音）" />

                    <Button x:Name="RefreshAudioDevicesButton" Grid.Column="1" VerticalAlignment="Bottom"
                            Content="刷新设备" Click="RefreshAudioDevicesButton_Click" Margin="0,0,0,1"
                            ToolTipService.ToolTip="重新扫描系统扬声器与音频播放设备" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 卡片 3: 字幕历史保留队列 -->
        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <StackPanel Spacing="14">
                <TextBlock Text="字幕历史保留" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                <TextBlock Text="断句规则：遇句号/问号/感叹号立即切句；实时识别中每累计 2 个逗号自动切为一句独立字幕。" 
                           Style="{StaticResource CaptionTextBlockStyle}" 
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                <!-- 固定宽度布局，杜绝重排 -->
                <Grid ColumnSpacing="16" Width="480" HorizontalAlignment="Left">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SubtitleQueueComboBox" Header="字幕保留句数"
                              Width="260" HorizontalAlignment="Left"
                              SelectionChanged="SubtitleQueueComboBox_SelectionChanged"
                              ToolTipService.ToolTip="选择同时保留的句子数量">
                        <ComboBoxItem Content="1 句 (单句覆盖)" Tag="1" />
                        <ComboBoxItem Content="2 句" Tag="2" />
                        <ComboBoxItem Content="3 句 (默认)" Tag="3" />
                        <ComboBoxItem Content="4 句" Tag="4" />
                        <ComboBoxItem Content="5 句" Tag="5" />
                        <ComboBoxItem Content="6 句" Tag="6" />
                    </ComboBox>

                    <Button x:Name="ClearSubtitleQueueButton" Grid.Column="1" VerticalAlignment="Bottom"
                            Content="清空字幕历史" Click="ClearSubtitleQueueButton_Click" Margin="0,0,0,1"
                            ToolTipService.ToolTip="立即清除当前屏幕卡片中保留积累的全部语音识别与翻译历史" />
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
