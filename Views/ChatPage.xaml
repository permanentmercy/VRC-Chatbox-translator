<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="VrcChatboxDemo.Views.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- 常规页面安全边距 -->
    <Grid x:Name="PageRootGrid" Padding="8,6,8,8" Background="Transparent">
        <Grid.RowDefinitions>
            <!-- 语音与翻译上层同框卡片 -->
            <RowDefinition Height="Auto" />
            <!-- 消息输入卡片 -->
            <RowDefinition x:Name="InputRowDef" Height="*" />
        </Grid.RowDefinitions>

        <!-- 1. 语音识别与翻译结果显示容器：四角圆角矩形，仅纯净显示内容无多余状态与按钮 -->
        <Border x:Name="SpeechDisplayCard"
                Grid.Row="0"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Margin="0,0,0,8"
                Padding="14,8,14,10"
                MinHeight="38"
                Visibility="Collapsed">
            <Grid RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 识别原文区域（无识别内容时不显示） -->
                <Grid x:Name="RecognizedRow" Grid.Row="0" Visibility="Collapsed">
                    <TextBlock x:Name="RecognizedTextBlock"
                               Text=""
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="15"
                               LineHeight="22"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- 翻译内容区域（支持显示请求延迟） -->
                <Grid x:Name="TranslatedRow" Grid.Row="1" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TranslatedTextBlock"
                               Grid.Column="0"
                               Text=""
                               TextWrapping="Wrap"
                               IsTextSelectionEnabled="True"
                               FontSize="15"
                               FontWeight="Medium"
                               LineHeight="22"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TranslationLatencyTextBlock"
                               Grid.Column="1"
                               VerticalAlignment="Top"
                               Margin="8,2,0,0"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               Visibility="Collapsed" />
                </Grid>
            </Grid>
        </Border>

        <!-- 2. 消息输入圆角矩形卡片 -->
        <Border x:Name="InputCard"
                Grid.Row="1"
                CornerRadius="8"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Grid>
                <TextBox x:Name="MessageInputBox"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         BorderThickness="0"
                         Background="Transparent"
                         FontSize="16"
                         Padding="14,10,14,32"
                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         TextChanged="MessageInputBox_TextChanged"
                         PreviewKeyDown="MessageInputBox_PreviewKeyDown"
                         TextCompositionStarted="MessageInputBox_TextCompositionStarted"
                         TextCompositionEnded="MessageInputBox_TextCompositionEnded">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    </TextBox.Resources>
                </TextBox>

                <!-- 字符数提示 -->
                <TextBlock x:Name="CharCountTextBlock"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Bottom"
                           Margin="0,0,14,6"
                           Text="0 / 144 "
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Page>
